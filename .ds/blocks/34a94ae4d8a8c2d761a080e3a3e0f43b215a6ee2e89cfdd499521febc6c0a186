func (a *Auth) Sweep(ctx context.Context, retention time.Duration) (SweepResult, error) {
	if a.db == nil {
		return nil, ErrNoDatabase
	}
	now := a.now()
	cutoff := now.Add(-retention)
	out := SweepResult{}
	d := a.cfg.Dialect
	run := func(name string, q Statement) error {
		n, err := a.Exec(ctx, q)
		if err != nil {
			return fmt.Errorf("auth: sweep %s: %w", name, err)
		}
		out[name] = n
		return nil
	}
	// Sessions: the store's own sweep, reported under the core table's name
	// whatever the store; stateless mode has nothing to delete.
	if a.sessions != nil {
		n, err := a.sessions.Sweep(ctx, now)
		if err != nil {
			return out, fmt.Errorf("auth: sweep %s: %w", CorePluginName+"."+TableNameSession, err)
		}
		out[CorePluginName+"."+TableNameSession] = n
	}
	if err := run(CorePluginName+"."+TableNameVerification, sqlb.NewDelete(d).From(TableVerification).Where(sqlb.Or(
		sqlb.Less(VerificationExpiresAt, cutoff),
		sqlb.Less(VerificationConsumedAt, &cutoff),
	))); err != nil {
		return out, err
	}
	if err := run(CorePluginName+"."+TableNameCode, sqlb.NewDelete(d).From(tableCode).Where(sqlb.Less(codeExpiresAt, cutoff))); err != nil {
		return out, err
	}
	rates := a.dbRates
	if !rates {
		var err error
		if rates, err = a.rateTableMigrated(ctx); err != nil {
			return out, err
		}
	}
	if rates {
		n, err := (&dbRateStore{a: a}).Sweep(ctx)
		if err != nil {
			return out, fmt.Errorf("auth: sweep %s: %w", CorePluginName+"."+TableNameRateLimit, err)
		}
		out[CorePluginName+"."+TableNameRateLimit] = n
	}
	for _, p := range a.plugins {
		if sw, ok := p.(Sweeper); ok {
			n, err := sw.Sweep(ctx, cutoff)
			if err != nil {
				return out, fmt.Errorf("auth: sweep %s: %w", p.Name(), err)
			}
			out[p.Name()] = n
		}
	}
	return out, nil
}