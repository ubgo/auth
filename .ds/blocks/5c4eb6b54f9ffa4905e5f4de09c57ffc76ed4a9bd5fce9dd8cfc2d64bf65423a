func AlgorithmKeys(keys ...crypto.Signer) Option {
	return func(p *Plugin) {
		for _, k := range keys {
			if ek, ok := k.(ed25519.PrivateKey); k == nil || (ok && len(ek) != ed25519.PrivateKeySize) {
				p.algKeysErr = fmt.Errorf("%w: a nil or short key", ErrAlgorithmKeys)
				continue
			}
			p.algKeys = append(p.algKeys, keySigner{key: k})
		}
	}
}