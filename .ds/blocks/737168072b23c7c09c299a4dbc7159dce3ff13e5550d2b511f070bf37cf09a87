func (a *Auth) Exec(ctx context.Context, s Statement) (int64, error) {
	c, q, err := a.prepare(ctx, s)
	if err != nil {
		return 0, err
	}
	ctx, end := a.dbSpan(ctx, q.SQL)
	res, err := c.ExecContext(ctx, q.SQL, q.Args...)
	if err != nil {
		end(err)
		return 0, err
	}
	n, err := res.RowsAffected()
	end(err)
	return n, err
}