func (a *Auth) PromoteSession(ctx context.Context, c *Call) (Session, error) {
	if c.Session == nil || !c.Session.SecondFactorPending {
		return Session{}, ErrSignedOut
	}
	var out Session
	err := a.Tx(ctx, func(ctx context.Context, _ sqlbTx) error {
		if err := a.DeleteSession(ctx, c.Session.UserID, c.Session.ID); err != nil {
			return err
		}
		s, tok, err := a.createSessionFull(ctx, c.Session.UserID, c.Client, false, nil, 0, c.Session.Transient)
		if err != nil {
			return err
		}
		c.Effects.IssueSessionOf(s, tok)
		out = s
		return nil
	})
	return out, err
}