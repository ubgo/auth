func (p *Plugin) SetLimits(ctx context.Context, id string, l Limits) error {
	if err := l.validate(); err != nil {
		return err
	}
	set := append(limitAssignments(l.withDefaults()), sqlb.Set(KeyRateCount, int64(0)), sqlb.Set(KeyRateWindowStart, (*time.Time)(nil)), sqlb.Set(KeyLastRefillAt, (*time.Time)(nil)))
	n, err := p.core.Exec(ctx, sqlb.NewUpdate(p.core.Dialect()).Table(TableKey).Set(set...).Where(sqlb.Eq(KeyID, id)))
	if err != nil {
		return err
	}
	if n == 0 {
		return ErrNotFound
	}
	return nil
}