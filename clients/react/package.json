{
  "name": "@ubgo/auth-react",
  "version": "0.1.0",
  "private": false,
  "description": "React bindings for the github.com/ubgo/auth TypeScript client: provider, session hooks, plugin gating, localization and the customisation contract the copy-in UI components follow.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ubgo/auth.git",
    "directory": "clients/react"
  },
  "homepage": "https://ubgo.github.io/auth/",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc -p .",
    "build": "node scripts/pack.mjs build",
    "prepack": "node scripts/pack.mjs build",
    "prepublishOnly": "node scripts/pack.mjs guard",
    "publish:dry-run": "node scripts/pack.mjs dry-run",
    "registry:build": "shadcn build registry/registry.json --output registry/r"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@ubgo/auth-client": "^0.1.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@ubgo/auth-client": "link:../ts",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "input-otp": "1.5.0",
    "jsdom": "26.1.0",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.4",
    "typescript": "5.9.3",
    "uqr": "0.1.2",
    "vitest": "3.2.4"
  }
}
