{
  "name": "ubgo-auth-showcase",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A static, mock-backed showcase of the React kit: every registry component live on a stage, with its install line and a usage snippet. Published to GitHub Pages with the shadcn registry under r/.",
  "scripts": {
    "dev": "vite",
    "registry": "node scripts/build-registry.mjs",
    "typecheck": "tsc -b",
    "build": "tsc -b && node scripts/build-registry.mjs && vite build && node scripts/spa-fallback.mjs",
    "preview": "vite preview",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.1",
    "@ubgo/auth-client": "link:../../ts",
    "@ubgo/auth-react": "link:..",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uqr": "0.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.64.0",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
